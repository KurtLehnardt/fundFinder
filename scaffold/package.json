{
  "name": "gov-opportunity-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:contracts": "node --import tsx --test \"lib/contracts/__tests__/*.test.ts\"",
    "data:fetch": "node scripts/1-fetch.mjs",
    "data:normalize": "node scripts/2-normalize.mjs",
    "data:embed": "node scripts/3-embed.mjs",
    "data:precompute": "node scripts/4-precompute.mjs",
